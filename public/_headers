# Canonical Link header for root path
/
  Link: <https://icraaz.com/>; rel="canonical"

# Security headers (all responses)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Frame policy for HTML documents
/*.html
  X-Frame-Options: DENY

# Cache hashed build assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache hashed Astro build output (content-hashed filenames)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache self-hosted fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Cache social preview + icons
/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400

# Sitemap content-type
/sitemap*.xml
  Content-Type: application/xml; charset=utf-8

# IndexNow verification key
/*.txt
  Cache-Control: public, max-age=86400
