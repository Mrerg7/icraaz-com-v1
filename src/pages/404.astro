---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME } from '../lib/constants';
---

<BaseLayout
  title={`404 — Page Not Found | ${SITE_NAME}`}
  description="The page you requested could not be found."
  noindex={true}
>
  <main class="min-h-screen flex items-center justify-center px-6 text-center">
    <div>
      <h1 class="heading-font text-7xl md:text-8xl font-bold tracking-tighter text-slate-900 mb-4">
        404
      </h1>
      <p class="text-xl text-slate-600 mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist. But the domain you're looking for does.
      </p>
      <a
        href="/"
        class="cta-button text-lg"
      >
        Return to icraaz.com
      </a>
    </div>
  </main>
</BaseLayout>
