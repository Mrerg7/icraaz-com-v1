---
import {
  SITE_URL,
  SITE_NAME,
  HERO_IMAGE_URL,
  ACQUISITION_EMAIL,
} from '../lib/constants';

const description =
  'icraaz.com — The exact-match, premium .com domain for Infection Control Risk Assessment (ICRA) expertise, training, consulting, and compliance in Arizona healthcare construction.';

const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${SITE_NAME} — Premium Domain for ICRA in Arizona Healthcare Construction`,
  description,
  url: SITE_URL,
  inLanguage: 'en-US',
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: HERO_IMAGE_URL,
    contentUrl: HERO_IMAGE_URL,
  },
  about: {
    '@type': 'Thing',
    name: 'Infection Control Risk Assessment (ICRA) Domain',
    description:
      'Premium .com domain name asset for ICRA expertise, training, consulting, and compliance services in Arizona healthcare construction.',
  },
};

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  email: ACQUISITION_EMAIL,
  logo: HERO_IMAGE_URL,
  description,
};

const product = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'icraaz.com domain name',
  description:
    'Premium domain for Infection Control Risk Assessment in Arizona healthcare construction. An exact-match, geo-targeted domain asset for ICRA training, consulting, and compliance.',
  image: [HERO_IMAGE_URL],
  brand: {
    '@type': 'Brand',
    name: SITE_NAME,
  },
  sku: 'icraaz.com',
  mpn: 'icraaz.com',
  category: 'Domain Name',
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    price: '14997',
    priceCurrency: 'USD',
    seller: {
      '@type': 'Organization',
      email: ACQUISITION_EMAIL,
    },
    url: `mailto:${ACQUISITION_EMAIL}`,
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: {
        '@type': 'MonetaryAmount',
        value: '0.00',
        currency: 'USD',
      },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: {
          '@type': 'QuantitativeValue',
          minValue: 0,
          maxValue: 1,
          unitCode: 'd',
        },
        transitTime: {
          '@type': 'QuantitativeValue',
          minValue: 0,
          maxValue: 0,
          unitCode: 'd',
        },
      },
      shippingDestination: {
        '@type': 'DefinedRegion',
        addressCountry: 'US',
      },
    },
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      returnMethod: 'https://schema.org/ReturnByMail',
      returnFees: 'https://schema.org/FreeReturn',
      applicableCountry: 'US',
      merchantReturnDays: 0,
    },
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(webPage)} />
<script type="application/ld+json" set:html={JSON.stringify(organization)} />
<script type="application/ld+json" set:html={JSON.stringify(product)} />
